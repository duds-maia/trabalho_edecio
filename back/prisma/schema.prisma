// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum PrestadorStatus {
  PENDENTE
  APROVADO
  REPROVADO
  SUSPENSO
  BANIDO
}

enum SolicitacaoStatus {
  PENDENTE
  ACEITO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum TipoAtendimento {
  URGENCIA
  AGENDADO
}

// ============================================
// MODELS
// ============================================

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String   // hash bcrypt
  telefone  String
  endereco  String
  latitude  Float
  longitude Float
  fotoUrl   String   // foto obrigatória

  // Relacionamentos
  solicitacoes Solicitacao[]
  avaliacoes   Avaliacao[]

  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("clientes")
}

model Admin {
  id   String @id @default(cuid())
  nome String
  email String @unique
  senha String // hash bcrypt

  // Relacionamentos
  prestadores Prestador[]

  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("admins")
}

model Categoria {
  id          String @id @default(cuid())
  nome        String @unique
  descricao   String

  // Relacionamentos
  prestadores Prestador[]
  solicitacoes Solicitacao[]

  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("categorias")
}

model Prestador {
  id            String           @id @default(cuid())
  categoriaId   String
  adminId       String
  nome          String
  email         String           @unique
  senha         String           // hash bcrypt
  telefone      String
  avaliacao     Float            @default(0) // 1 a 5 estrelas
  status        PrestadorStatus  @default(PENDENTE)
  endereco      String
  latitude      Float
  longitude     Float
  fotoUrl       String           // foto obrigatória
  localizacaoAtualizadaEm DateTime @default(now())

  // Relacionamentos
  categoria     Categoria @relation(fields: [categoriaId], references: [id])
  admin         Admin     @relation(fields: [adminId], references: [id])
  solicitacoes  Solicitacao[]
  avaliacoes    Avaliacao[]

  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("prestadores")
}

model Solicitacao {
  id              String            @id @default(cuid())
  clienteId       String
  prestadorId     String?
  categoriaId     String
  descricao       String
  endereco        String
  latitude        Float
  longitude       Float
  tipoAtendimento TipoAtendimento
  dataAgendamento DateTime?
  status          SolicitacaoStatus @default(PENDENTE)
  valor           Float?            // opcional no início, preenchido quando aceito
  fotoUrl         String            // foto obrigatória

  // Relacionamentos
  cliente         Cliente           @relation(fields: [clienteId], references: [id])
  prestador       Prestador?        @relation(fields: [prestadorId], references: [id])
  categoria       Categoria         @relation(fields: [categoriaId], references: [id])

  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("solicitacoes")
}

model Avaliacao {
  id          String   @id @default(cuid())
  clienteId   String
  prestadorId String
  nota        Float    // 1 a 5 estrelas
  comentario  String?

  // Relacionamentos
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  prestador   Prestador @relation(fields: [prestadorId], references: [id])

  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("avaliacoes")
}
